{
  "name": "wallpy-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:types": "supabase gen types typescript --project-id tblvogsucpzuqbhcvwba --schema public > lib/database.types.ts",
    "test": "vitest run",
    "test:e2e:api": "node --env-file=.env.local tests/e2e/upload-api.mjs",
    "test:e2e:ui": "node --env-file=.env.local tests/e2e/upload-ui.mjs",
    "test:e2e:moderation": "node --env-file=.env.local tests/e2e/moderation-ui.mjs",
    "test:e2e:versions": "node --env-file=.env.local tests/e2e/versions-ui.mjs",
    "test:e2e:builders": "node --env-file=.env.local tests/e2e/builders-ui.mjs",
    "test:e2e": "npm run test:e2e:api && npm run test:e2e:ui && npm run test:e2e:moderation && npm run test:e2e:versions && npm run test:e2e:builders"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@heroicons/react": "^2.2.0",
    "@iarna/toml": "^2.2.5",
    "@radix-ui/react-select": "^2.2.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ajv": "^8.20.0",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.18.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-blurhash": "^0.3.0",
    "react-dom": "^19.3.1",
    "react-icons": "^5.5.0",
    "server-only": "^0.0.1",
    "simple-icons": "^15.4.0",
    "suncalc": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
